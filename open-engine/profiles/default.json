{
  "schemaVersion": 1,
  "name": "default",
  "mode": "record-only",
  "hooks": [
    {
      "id": "network.task.resume",
      "type": "objc",
      "target": {
        "class": "NSURLSessionTask",
        "selector": "resume"
      },
      "capture": ["arguments", "return", "stack"],
      "redact": ["authorization", "cookie", "set-cookie"],
      "sampleRate": 1
    }
  ]
}
